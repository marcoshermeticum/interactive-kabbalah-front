    "ainSoph": {
      "ain": {
        "name": "アイン",
        "subtitle": "無",
        "description": "絶対的な無 — いかなる顕現にも先立つ原初の状態。ゴールデン・ドーンの伝統において、アインは純粋な否定性を表し、潜在性すら先立つ不可思議なる虚空である。",
        "goldenDawn": "否定的存在の第一のヴェール。アインはゴールデン・ドーンの文書において、人間の理解を完全に超越するものとして記述される — 存在でも非存在でもなく、その両者に先立つ状態。",
        "principle": "絶対的否定性 — 存在と非存在を超えて",
        "relation": "アイン・ソフに先行する — 無限なるものの不可思議な根源"
      },
      "ainSoph": {
        "name": "アイン・ソフ",
        "subtitle": "無限",
        "description": "無限なるもの — 形態、尺度、属性なき無限の拡張。ゴールデン・ドーンにおいて、アイン・ソフは第二の否定的抽象を表す：すべての可能性を含むが何も顕現しない無限の潜在力。",
        "goldenDawn": "否定的存在の第二のヴェール。マサースとウェストコットはアイン・ソフを無限の延長として記述する — 始まりも終わりも方向もない。光が集中する前の純粋な無限性の概念である。",
        "principle": "属性なき無限 — 純粋な未顕現の潜在力",
        "relation": "アインとアイン・ソフ・アウルの間 — 光に先立つ無限"
      },
      "ainSophAur": {
        "name": "アイン・ソフ・アウル",
        "subtitle": "無限光",
        "description": "無限光 — 無限なるものの最初の放射、原初の創造衝動。ゴールデン・ドーンにおいて、これは絶対者が流出を決意する瞬間を表す：光が一点（ケテル）に集中し、生命の樹が誕生する。",
        "goldenDawn": "否定的存在の第三のヴェール。ゴールデン・ドーンの儀式は、アイン・ソフ・アウルが一点に集中する無限光であると教える — ケテル（王冠）を形成する。これはルリア・カバラのツィムツム：創造を可能にする収縮である。",
        "principle": "原初の光 — 顕現の最初の衝動",
        "relation": "ケテルに直接先行する — 最初のセフィラの源泉"
      }
    },
