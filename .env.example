# Google Analytics 4 — Measurement ID
# Get yours at: https://analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_ID=

# Public canonical origin used by SEO (metadata, canonical URLs, sitemap).
# Set it only when using a custom domain, e.g. https://interactivekabbalah.com
# When empty, Vercel's VERCEL_PROJECT_PRODUCTION_URL is used automatically,
# falling back to https://interactive-kabbalah-front.vercel.app in production builds.
NEXT_PUBLIC_SITE_URL=

# === Admin Panel ===
# SHA-256 hash of the admin password
ADMIN_PASSWORD_HASH=

# JWT secret for admin sessions (generate a random string, min 32 chars)
ADMIN_JWT_SECRET=

# Secret for captcha HMAC signatures
CAPTCHA_SECRET=

# Github API — for content management
# (prefixo GH_ porque GitHub Actions reserva o prefixo GITHUB_)
GH_API_TOKEN=
GH_REPO_OWNER=
GH_REPO_NAME=
# GH_REPO_BRANCH defaults to "main" if not set
