# Google Analytics 4 — Measurement ID
# Get yours at: https://analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# === Admin Panel ===
# SHA-256 hash of the admin password
ADMIN_PASSWORD_HASH=REDACTED_PASSWORD_HASH

# JWT secret for admin sessions (generate a random string, min 32 chars)
ADMIN_JWT_SECRET=your-random-secret-at-least-32-chars

# Secret for captcha HMAC signatures
CAPTCHA_SECRET=your-captcha-secret-here

# GitHub API — for content management
GITHUB_TOKEN=ghp_your_fine_grained_token_here
GITHUB_OWNER=your-github-username
GITHUB_REPO=interactive-kabbalah-front
GITHUB_BRANCH=main
