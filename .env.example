# Google Analytics 4 — Measurement ID
# Get yours at: https://analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_ID=

# === Admin Panel ===
# SHA-256 hash of the admin password
ADMIN_PASSWORD_HASH=

# JWT secret for admin sessions (generate a random string, min 32 chars)
ADMIN_JWT_SECRET=

# Secret for captcha HMAC signatures
CAPTCHA_SECRET=

# Github API — for content management
# (prefixo GH_ porque GitHub Actions reserva o prefixo GITHUB_)
GH_TOKEN=
GH_OWNER=
GH_REPO=
# GH_REPO_BRANCH defaults to "main" if not set
